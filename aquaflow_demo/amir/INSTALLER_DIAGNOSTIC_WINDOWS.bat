@echo off
setlocal
set "AMIR_DIAGNOSTIC_SOURCE=%~dp0"
title AquaFlow - Diagnostic des connexions
echo Selectionne DEMARRER_HTTPS_WINDOWS.bat dans ton projet amir actuel.
powershell.exe -NoLogo -NoProfile -STA -Command "$ErrorActionPreference='Stop'; try { Add-Type -AssemblyName System.Windows.Forms; $dialog=New-Object System.Windows.Forms.OpenFileDialog; $dialog.Title='Choisis DEMARRER_HTTPS_WINDOWS.bat dans ton dossier amir actuel'; $dialog.Filter='Lanceur HTTPS AquaFlow|DEMARRER_HTTPS_WINDOWS.bat'; $dialog.InitialDirectory=[Environment]::GetFolderPath('UserProfile'); if ($dialog.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { Write-Host 'Annule. Aucun fichier modifie.'; exit 0 }; $root=[IO.Path]::GetDirectoryName($dialog.FileName); if (!(Test-Path -LiteralPath (Join-Path $root 'config\local.php')) -or !(Test-Path -LiteralPath (Join-Path $root 'controllers\SocialController.php'))) { throw 'Choisis le lanceur de ton projet configure, dans son dossier amir.' }; $payload=Join-Path $env:AMIR_DIAGNOSTIC_SOURCE 'fichiers'; if (!(Test-Path -LiteralPath $payload)) { $payload=$env:AMIR_DIAGNOSTIC_SOURCE }; $entries=@(@{name='controllers\SocialController.php';old='615DC5CBE6511CB0718BD1DF18C97F8980FE38E90C605C25AEDEA13D755E951C';previous='19EA5CE9E6131C3A61316742AD8E4929DBC084A8151034036AC9FBD964FFC6E7';new='957566A0533B08D710EBCAF796479C4FE9B723E1A9C54282CEC657BB9EA8A61E'},@{name='bin\diagnostic_connexions.php';old='';new='90809A6CD3B676C3E15D69F0657FB66902D35546933CE12DEA3206FFB0AF9C68'}); foreach ($e in $entries) { $source=Join-Path $payload $e.name; if (!(Test-Path -LiteralPath $source) -or (Get-FileHash -LiteralPath $source -Algorithm SHA256).Hash -ne $e.new) { throw 'Fichiers du diagnostic absents ou modifies. Extrais tout le ZIP puis relance.' }; $target=Join-Path $root $e.name; if ((Test-Path -LiteralPath $target) -and @($e.old,$e.previous,$e.new) -notcontains (Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash) { throw ('Version differente : '+$e.name+'. Aucun remplacement effectue. Envoie ce message.') }; }; $private=Join-Path $root 'var\diagnostic-updates'; [void][IO.Directory]::CreateDirectory($private); foreach ($e in $entries) { $source=Join-Path $payload $e.name; $target=Join-Path $root $e.name; if ((Test-Path -LiteralPath $target) -and (Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash -eq $e.new) { continue }; $id=[Guid]::NewGuid().ToString('N'); $temporary=Join-Path $private ($id+'.tmp'); $backup=Join-Path $private ($id+'-'+[IO.Path]::GetFileName($target)); try { [IO.File]::WriteAllBytes($temporary,[IO.File]::ReadAllBytes($source)); if (Test-Path -LiteralPath $target) { [IO.File]::Replace($temporary,$target,$backup) } else { [IO.File]::Move($temporary,$target) } } finally { if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary } }; if ((Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash -ne $e.new) { throw 'La copie du diagnostic a echoue. La sauvegarde reste dans var\diagnostic-updates.' }; }; Write-Host 'Diagnostic installe. Les identifiants, les comptes et la 2FA sont conserves.'; $php='C:\xampp\php\php.exe'; if (!(Test-Path -LiteralPath $php)) { $php=(Get-Command php -ErrorAction Stop).Source }; & $php (Join-Path $root 'bin\diagnostic_connexions.php'); Write-Host 'Garde cette fenetre ouverte pour envoyer le resultat. Redemarre ensuite le serveur HTTPS avant le nouvel essai Google ou Facebook.'; } catch { Write-Host ('Erreur : '+$_.Exception.Message); exit 1 }"
pause

