ce)); [IO.File]::Replace($temporary,$target,$backup); } finally { if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary } }; if ((Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash -ne $new) { throw 'Verification de la copie echouee. La sauvegarde reste dans var\facebook-updates.' }; }; Write-Host 'Correction installee. Tes reglages, comptes et donnees 2FA sont conserves.'; Write-Host 'Arrete le SERVEUR HTTPS avec Entree dans SA fenetre, puis relance DEMARRER_HTTPS_WINDOWS.bat depuis ton projet habituel.'; Write-Host 'Reconnecte-toi avec Google, puis Securite > Associer Facebook.'; Write-Host 'Si une erreur apparait, envoie seulement le nouveau texte rouge, sans les cles.'; } catch { Write-Host ('Erreur : '+$_.Exception.Message); exit 1 }"
