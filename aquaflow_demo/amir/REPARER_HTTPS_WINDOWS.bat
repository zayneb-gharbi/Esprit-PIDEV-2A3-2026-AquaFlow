@echo off
setlocal
title AquaFlow - Reparation HTTPS
echo Selectionne le fichier DEMARRER_HTTPS_WINDOWS.bat de ton projet amir.
echo La correction sera appliquee au lanceur PHP puis le site sera relance.
echo Les identifiants et la base de donnees ne sont pas modifies.
powershell.exe -NoLogo -NoProfile -STA -Command "$ErrorActionPreference='Stop'; try { Add-Type -AssemblyName System.Windows.Forms; $dialog=New-Object System.Windows.Forms.OpenFileDialog; $dialog.Title='Choisis DEMARRER_HTTPS_WINDOWS.bat dans le dossier amir de ton projet'; $dialog.Filter='Lanceur HTTPS AquaFlow|DEMARRER_HTTPS_WINDOWS.bat'; $dialog.InitialDirectory=[Environment]::GetFolderPath('UserProfile'); if ($dialog.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { Write-Host 'Annule. Aucun fichier modifie.'; exit 0 }; $root=[IO.Path]::GetDirectoryName($dialog.FileName); $file=Join-Path $root 'bin\demarrer_https.php'; $config=Join-Path $root 'config\local.php'; $assets=Join-Path ([IO.Path]::GetDirectoryName($root)) 'assets\style.css'; if (!(Test-Path -LiteralPath $file) -or !(Test-Path -LiteralPath $config) -or !(Test-Path -LiteralPath $assets)) { throw 'Ce dossier ne contient pas le projet configure. Relance et choisis le lanceur dans ton ancien dossier amir.' }; $text=[IO.File]::ReadAllText($file); $q=[string][char]39; $needle=$q+'--cacert'+$q+', $certificat, '+$q+'--output'+$q+', '+$q+'NUL'+$q+', $adresse . '+$q+'/security.css'+$q; $replacement=$q+'--cacert'+$q+', $certificat, '+$q+'--ssl-revoke-best-effort'+$q+', '+$q+'--output'+$q+', '+$q+'NUL'+$q+', $adresse . '+$q+'/security.css'+$q; if ($text.Contains($replacement)) { Write-Host 'La correction est deja presente.' } else { if ([regex]::Matches($text,[regex]::Escape($needle)).Count -ne 1) { throw 'Version du fichier non reconnue. Aucun fichier modifie. Envoie ce message.' }; $private=Join-Path $root 'var\https'; [void][IO.Directory]::CreateDirectory($private); $id=[Guid]::NewGuid().ToString('N'); $temporary=Join-Path $private ('reparation-'+$id+'.tmp'); $backup=Join-Path $private ('demarrer-avant-correction-'+$id+'.php'); try { [IO.File]::WriteAllText($temporary,$text.Replace($needle,$replacement),[Text.UTF8Encoding]::new($false)); [IO.File]::Replace($temporary,$file,$backup) } finally { if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary } }; if (!([IO.File]::ReadAllText($file).Contains($replacement))) { throw 'La correction n a pas pu etre verifiee. La sauvegarde est dans var\https.' }; Write-Host 'Correction appliquee. Sauvegarde du lanceur dans var\https.'; }; Write-Host 'Le lanceur HTTPS va ouvrir une nouvelle fenetre. Attends HTTPS est pret.'; Start-Process -FilePath $dialog.FileName -WorkingDirectory $root; } catch { Write-Host ('Erreur : '+$_.Exception.Message); exit 1 }"
pause

